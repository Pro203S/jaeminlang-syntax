{
  "name": "jaeminlang-syntax",
  "displayName": "jaeminlang-syntax",
  "description": "재민랭(.jml) 문법 하이라이팅과 포맷팅을 지원합니다.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:jaeminlang"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jaeminlang",
        "aliases": [
          "재민랭",
          "Jaeminlang"
        ],
        "extensions": [
          ".jml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jaeminlang",
        "scopeName": "source.jaeminlang",
        "path": "./syntaxes/jaeminlang.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "jaeminlang",
        "scopes": {
          "function": [
            "entity.name.function.jaeminlang"
          ],
          "parameter": [
            "variable.parameter.jaeminlang"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
